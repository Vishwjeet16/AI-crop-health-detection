# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Database ---------------------------------------------------------------
# MongoDB holds every collection (users, fields, scans, alerts, weather) plus
# the scan images, in a GridFS bucket. Nothing here needs creating by hand: the
# collections appear on first write and the indexes are created at API startup.
# The defaults below match a stock local install, so a developer running mongod
# locally can leave this section alone.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cropguard
# Short on purpose: a stopped mongod should surface as a fast 503 rather than a
# request that hangs for the driver's 30s default.
MONGODB_TIMEOUT_MS=5000

# This server's own base URL, used to build the absolute image_url the frontend
# renders. next/image resolves a relative path against the frontend's origin,
# not the API's, so this has to be set correctly wherever the API is deployed.
API_BASE_URL=http://localhost:8000

# --- Auth (Supabase — being replaced by Firebase Auth) ----------------------
# Still used for login/signup only; all application data now lives in MongoDB.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

AI_MODE=demo
WEATHER_API_KEY=

# --- AI assistant (POST /api/assistant/chat) --------------------------------
# Get a key at console.anthropic.com. Leave blank to run without the assistant:
# the chat endpoint returns a 503 explaining what's missing and every other
# feature keeps working.
ANTHROPIC_API_KEY=
# Optional overrides — the defaults in app/config.py are what you want unless
# you have a reason. ASSISTANT_EFFORT accepts low | medium | high | xhigh | max;
# low is the main latency lever and is strong on this model.
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_MAX_TOKENS=4096
# ASSISTANT_EFFORT=low
# ASSISTANT_HISTORY_TURNS=8

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=8
