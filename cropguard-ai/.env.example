# Copy this file to frontend/.env.local and backend/.env, then fill in real values.
# NEVER commit the filled-in files — both are already in .gitignore.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Backend / AI ---
AI_MODE=demo
WEATHER_API_KEY=

# --- Backend base URL used by the frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "false" once backend/ is running with Supabase configured, to
# switch the frontend off its built-in mock data layer.
NEXT_PUBLIC_USE_MOCK_API=true
