# Copy to frontend/.env.local and fill in real values. Never commit .env.local.

# Where the FastAPI backend is listening.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "false" talks to the real backend. Anything else (including unset) keeps the
# app on the built-in mock data, which is useful for UI work without a server.
NEXT_PUBLIC_USE_MOCK_API=false

# Needed only for Google sign-in, which runs browser-side against Supabase Auth.
# Both are public by design (the anon key is protected by row-level security).
# Leave them blank and the Google button hides itself — email/password login
# keeps working. See the "Google sign-in" setup steps in the README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
